# Salin jadi .env lalu isi dari Firebase Console > Project settings > Your apps (Web).
# Kalau kosong, game memakai mode lokal: buka 2 tab di browser yang sama untuk Navigator dan Spesialis.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
